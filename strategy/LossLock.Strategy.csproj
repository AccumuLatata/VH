<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Quantower 1.146+ and 1.147 ship against .NET 10. build.ps1 overrides this
         from the terminal's runtimeconfig.json when it can read one. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>LossLock</AssemblyName>
    <RootNamespace>LossLock</RootNamespace>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\src\LossLockRules.cs" Link="LossLockRules.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(QuantowerBusinessLayer)' != ''">
    <Reference Include="TradingPlatform.BusinessLayer">
      <HintPath>$(QuantowerBusinessLayer)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="RequireQuantowerReference" BeforeTargets="ResolveAssemblyReferences">
    <Error
      Condition="'$(QuantowerBusinessLayer)' == ''"
      Text="QuantowerBusinessLayer ist leer. Auf Windows build.ps1 ausführen, damit die Strategie gegen die installierte TradingPlatform.BusinessLayer.dll gebaut wird." />
  </Target>
</Project>
